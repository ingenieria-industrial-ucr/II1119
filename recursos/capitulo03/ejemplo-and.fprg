    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad, dinero" type="Integer" array="False" size=""/>
            <assign variable="edad" expression="18"/>
            <assign variable="dinero" expression="10000"/>
            <if expression="edad &gt;= 18 AND dinero &gt;= 10000">
                <then>
                    <output expression="&quot;Nos vamos para de fiesta para la Cali&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Nos quedamos en la casa para ver MovieFlix&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
