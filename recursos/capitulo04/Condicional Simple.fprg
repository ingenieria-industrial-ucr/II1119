    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="temp" type="Real" array="False" size=""/>
            <output expression="&quot;Indique la temperatura&quot;" newline="True"/>
            <input variable="temp"/>
            <if expression="temp &gt; 100">
                <then>
                    <output expression="&quot;Activar ventilador&quot;" newline="True"/>
                </then>
                <else>
                    <comment text="No hace falta poner &#13;&#10;pasos para la opci&#243;n False"/>
                </else>
            </if>
            <output expression="&quot;Sigue con las operaciones regulares&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
