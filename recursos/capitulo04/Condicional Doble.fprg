    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="piezaPeso" type="Real" array="False" size=""/>
            <output expression="&quot;Indique el peso de la pieza&quot;" newline="True"/>
            <input variable="piezaPeso"/>
            <if expression="piezaPeso &gt;= 500">
                <then>
                    <output expression="&quot;Aprobar&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Rechazar&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;Sigue con las operaciones regulares&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
